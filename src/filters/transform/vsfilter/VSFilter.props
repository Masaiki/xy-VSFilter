<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IncludePath>$(VcpkgIncludeDir);$(SolutionDir)src\filters\BaseClasses;$(SolutionDir)src\thirdparty\VirtualDub\h\;$(SolutionDir)include\;$(SolutionDir)msvc\include\;$(IncludePath)</IncludePath>
    <LibraryPath>$(SolutionDir)msvc\lib\$(PlatformTarget)\;$(LibraryPath)</LibraryPath>
    <OutDir>$(OutDir)$(Configuration)\</OutDir>
    <TargetExt>.dll</TargetExt>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions Condition="'$(VisualStudioVersion)'&gt;'10.0'">_AFX_NO_MFC_CONTROLS_IN_DIALOGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions Condition="'$(Configuration)|$(VisualStudioVersion)'=='Release|12.0'">/Gw %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Configuration)|$(VisualStudioVersion)'=='Release|16.0' Or '$(Configuration)|$(VisualStudioVersion)'=='Release|17.0'">/Gw /Qfast_transcendentals %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="UpdateVSFilterVersion" BeforeTargets="ClCompile">
    <Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(SolutionDir)scripts\update_vsfilter_version.ps1" -VersionHeader "$(MSBuildThisFileDirectory)version_in.h" -SolutionDir "$(SolutionDir)." -Platform "$(Platform)" -VcpkgTriplet "$(VcpkgTriplet)" -VcpkgRoot "$(VcpkgRoot)" -VcpkgInstalledDir "$(VcpkgInstalledDir)"' />
  </Target>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgLibraryDirectories);$(SolutionDir)lib;$(OutDir)..</AdditionalLibraryDirectories>
      <AdditionalDependencies Condition="'$(Configuration)'=='Debug'">strmbaseD.lib;dsutilD.lib;subtitlesD.lib;subpicD.lib;basevideofilterD.lib;libssfD.lib;log4cplusD.lib;KasumiD.lib;systemD.lib;unrarD.lib;Mfuuid.lib;$(LibassDebugLibraryName)</AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)'=='Debug' And '$(VisualStudioVersion)'&gt;'11.0'">strmbaseD.lib;dsutilD.lib;subtitlesD.lib;subpicD.lib;basevideofilterD.lib;libssfD.lib;log4cplusD.lib;KasumiD.lib;systemD.lib;unrarD.lib;dwmapi.lib;Mfuuid.lib;$(LibassDebugLibraryName)</AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)'=='Release'">delayimp.lib;strmbaseR.lib;dsutilR.lib;subtitlesR.lib;subpicR.lib;basevideofilterR.lib;libssfR.lib;log4cplus.lib;KasumiR.lib;systemR.lib;unrarR.lib;winmm.lib;Mfuuid.lib;$(LibassLibraryName)</AdditionalDependencies>
      <AdditionalDependencies Condition="'$(Configuration)'=='Release' And '$(VisualStudioVersion)'&gt;'11.0'">delayimp.lib;strmbaseR.lib;dsutilR.lib;subtitlesR.lib;subpicR.lib;basevideofilterR.lib;libssfR.lib;log4cplus.lib;KasumiR.lib;systemR.lib;unrarR.lib;winmm.lib;dwmapi.lib;Mfuuid.lib;$(LibassLibraryName)</AdditionalDependencies>
      <RegisterOutput>false</RegisterOutput>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>AFX_RESOURCE_DLL;AFX_TARG_ENU;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_USRDLL;ISOLATION_AWARE_ENABLED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <IntrinsicFunctions>false</IntrinsicFunctions>
      <BufferSecurityCheck>false</BufferSecurityCheck>
    </ClCompile>
    <Link>
	  <DelayLoadDLLs>oleacc.dll</DelayLoadDLLs>
      <Profile>false</Profile>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CopyVcpkgRuntimeDlls" AfterTargets="Build" Condition="'$(VcpkgRuntimeBinDir)'!='' and Exists('$(VcpkgRuntimeBinDir)')">
    <ItemGroup>
      <VcpkgRuntimeDll Include="$(VcpkgRuntimeBinDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VcpkgRuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
